        // Update current date
        document.getElementById('current-date').textContent = new Date().toLocaleDateString('en-IN', {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });

        // Tab switching
        function switchTab(tabName) {
            // Hide all content
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(content => content.classList.remove('active'));

            // Remove active from buttons
            const buttons = document.querySelectorAll('.tab-button');
            buttons.forEach(button => button.classList.remove('active'));

            // Show selected content
            document.getElementById(tabName).classList.add('active');

            // Add active to clicked button
            event.target.classList.add('active');

            // Redraw charts if switching to charts tab
            if (tabName === 'charts') {
                setTimeout(() => {
                    [taxPaymentChart, filingStatusChart, itcBreakdownChart, 
                     reconciliationChart, turnoverChart, complianceChart].forEach(chart => {
                        if (chart) chart.resize();
                    });
                }, 100);
            }
        }

        // Chart 1: Tax Payment Trend
        const taxPaymentCtx = document.getElementById('taxPaymentChart').getContext('2d');
        const taxPaymentChart = new Chart(taxPaymentCtx, {
            type: 'bar',
            data: {
                labels: ['April', 'May', 'June', 'July', 'August', 'September', 'October'],
                datasets: [{
                    label: 'Tax Paid (₹)',
                    data: [125000, 145000, 168000, 152000, 178000, 195000, 210000],
