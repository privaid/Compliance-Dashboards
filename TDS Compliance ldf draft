        function formatCurrency(amount) {
            if (!amount || isNaN(amount)) return '₹0';
            return '₹' + amount.toLocaleString('en-IN');
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            return date.toLocaleDateString('en-IN');
        }

        function getStatus(tdsDeposited, tdsDeducted) {
            if (tdsDeposited && parseFloat(tdsDeposited) === parseFloat(tdsDeducted)) {
                return 'Filed';
            } else if (tdsDeposited) {
                return 'Partial';
            }
            return 'Pending';
        }

        function populateQuarterData() {
            // Populate Q3 Section A
            const q3SectionABody = document.querySelector('#q3-section-a tbody');
            dashboardData.Q3.section_a.forEach(item => {
                const status = item['Challan No.'] && item['Challan No.'] !== '' ? 'Paid' : 'Unpaid';
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${item.Month}</td>
                    <td>${item['Deductee Name']}</td>
                    <td class="currency">${formatCurrency(item['Total Amount'])}</td>
                    <td class="currency">${formatCurrency(item['TDS Amount'])}</td>
                    <td class="currency">${formatCurrency(item['Net Amount Paid'])}</td>
                    <td>${formatDate(item['TDS Deducted On'])}</td>
                    <td><span class="status-badge ${status === 'Paid' ? 'status-filed' : 'status-pending'}">${status}</span></td>
                `;
                q3SectionABody.appendChild(row);
            });

            // Populate Q3 Section B
            const q3SectionBBody = document.querySelector('#q3-section-b tbody');
            dashboardData.Q3.section_b.forEach(item => {
                const status = item['Challan No.'] && item['Challan No.'] !== '' ? 'Paid' : 'Unpaid';
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${item.Month}</td>
                    <td>${item['Deductee Name']}</td>
                    <td>${item['TDS Section']}</td>
                    <td>${item['TDS Rate (%)']?.toFixed(2) || '-'}%</td>
                    <td class="currency">${formatCurrency(item['Invoice Amount'])}</td>
                    <td class="currency">${formatCurrency(item['TDS Amount'])}</td>
                    <td class="currency">${typeof item['Net Amount Paid'] === 'string' ? item['Net Amount Paid'] : formatCurrency(item['Net Amount Paid'])}</td>
                    <td><span class="status-badge ${status === 'Paid' ? 'status-filed' : 'status-pending'}">${status}</span></td>
                `;
                q3SectionBBody.appendChild(row);
            });

            // Update summary cards
            updateSummaryCards();
        }

        function updateSummaryCards() {
            // Q3 Summary
            const q3SectionA = dashboardData.Q3.section_a;
            const q3SectionB = dashboardData.Q3.section_b;

            const q3TotalInvoiceA = q3SectionA.reduce((sum, item) => sum + (item['Total Amount'] || 0), 0);
            const q3TotalTdsA = q3SectionA.reduce((sum, item) => sum + (item['TDS Amount'] || 0), 0);

            const q3TotalInvoiceB = q3SectionB.reduce((sum, item) => sum + (item['Invoice Amount'] || 0), 0);
            const q3TotalTdsB = q3SectionB.reduce((sum, item) => sum + (item['TDS Amount'] || 0), 0);

            const q3TotalInvoice = q3TotalInvoiceA + q3TotalInvoiceB;
            const q3TotalTds = q3TotalTdsA + q3TotalTdsB;
            const q3TotalDeductees = q3SectionA.length + q3SectionB.length;

            document.querySelectorAll('.q3-summary').forEach(el => {
                if (el.dataset.type === 'invoice') el.textContent = formatCurrency(q3TotalInvoice);
                if (el.dataset.type === 'tds') el.textContent = formatCurrency(q3TotalTds);
                if (el.dataset.type === 'count') el.textContent = q3TotalDeductees;
                if (el.dataset.type === 'compliance') el.textContent = '100%';
            });
        }

        function showQuarter(quarter) {
            // Hide all sections
            const sections = document.querySelectorAll('.section');
            sections.forEach(section => {
                section.classList.remove('active');
            });

            // Show selected section
            const selectedSection = document.getElementById(quarter);
            if (selectedSection) {
                selectedSection.classList.add('active');
            }

            // Update button styling
            const buttons = document.querySelectorAll('.quarter-btn');
            buttons.forEach(button => {
                button.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', populateQuarterData);
